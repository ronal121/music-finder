<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Music Finder"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search"
        android:paddingStart="10dp"
        android:paddingEnd="5dp">

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="نام خواننده یا آهنگ..."
            android:textColor="@color/white"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"/>

        <TextView
            android:id="@+id/search"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:background="@drawable/bg_button"
            android:text="⌕"
            android:textColor="@color/white"
            android:textSize="22sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="نام آهنگ را جستجو کنید"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:gravity="center_vertical"/>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- PLAYER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="14dp">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="هنوز آهنگی پخش نشده"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"/>

        <TextView
            android:id="@+id/artistText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music Finder"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="10sp"/>

            <SeekBar
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/duration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center">

            <TextView
                android:id="@+id/previousButton"
                android:layout_width="55dp"
                android:layout_height="50dp"
                android:text="|◀"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/playButton"
                android:layout_width="65dp"
                android:layout_height="50dp"
                android:text="▶"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/bg_button"/>

            <TextView
                android:id="@+id/nextButton"
                android:layout_width="55dp"
                android:layout_height="50dp"
                android:text="▶|"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/shuffleButton"
                android:layout_width="55dp"
                android:layout_height="50dp"
                android:text="↕"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/downloadButton"
                android:layout_width="55dp"
                android:layout_height="50dp"
                android:text="⬇"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- DOWNLOAD PROGRESS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/downloadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/downloadPercent"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:gravity="end"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

    <!-- PLAYLIST -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:text="نتایج"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center_vertical"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/playlistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"/>

    </ScrollView>

    <!-- HIDDEN WEBVIEW -->

    <WebView
        android:id="@+id/web"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="KAFSHAR • Music Finder"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:gravity="center"/>

</LinearLayout>
