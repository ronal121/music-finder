<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUSIC FINDER"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Find the music you're looking for."
                android:textColor="@color/muted"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="KAFSHAR"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"/>

        </LinearLayout>

        <!-- Search -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingStart="16dp"
            android:paddingEnd="7dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="@color/muted"
                android:textSize="25sp"/>

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:background="@android:color/transparent"
                android:hint="Search for a song or artist..."
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:singleLine="true"
                android:padding="0dp"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <TextView
                android:id="@+id/search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_search_button"
                android:text="→"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search"/>

        </LinearLayout>

        <!-- Status -->

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:gravity="start"/>

        <!-- Player -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_player">

            <com.kafshar.musicfinder.VinylView
                android:id="@+id/vinyl"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:contentDescription="Album artwork"/>

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Music Finder"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/artistText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ready to search"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"/>

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="15dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/muted"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/muted"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Player Controls -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/previousButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:contentDescription="Previous"/>

                <TextView
                    android:id="@+id/playButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_play_button"
                    android:text="▶"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:contentDescription="Play or pause"/>

                <TextView
                    android:id="@+id/nextButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:contentDescription="Next"/>

                <TextView
                    android:id="@+id/randomButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/muted"
                    android:textSize="22sp"
                    android:contentDescription="Shuffle"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Secondary actions -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_secondary_button"
                android:text="♡  Save"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:contentDescription="Save current song"/>

            <TextView
                android:id="@+id/libraryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:background="@drawable/bg_secondary_button"
                android:text="Library"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:contentDescription="Open library"/>

        </LinearLayout>

        <!-- Download -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bg_secondary_button">

            <TextView
                android:id="@+id/downloadButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="↓  Download"
                android:textColor="@color/white"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/pauseDownloadButton"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Ⅱ"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/cancelDownloadButton"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/muted"
                android:textSize="20sp"
                android:visibility="gone"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/downloadText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone"/>

        <!-- History -->

        <TextView
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:background="@drawable/bg_secondary_button"
            android:text="History"
            android:textColor="@color/white"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"/>

        <!-- Results -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="SEARCH RESULTS"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

        <!-- Existing WebView kept as the functional engine -->

        <WebView
            android:id="@+id/web"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="visible"/>

    </LinearLayout>

</ScrollView>
