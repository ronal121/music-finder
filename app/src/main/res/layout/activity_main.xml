<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Music Finder"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="≡"
            android:textColor="@color/white"
            android:textSize="25sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="جستجوی موسیقی در وب"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:paddingBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/muted"
            android:textSize="25sp" />

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="نام آهنگ، خواننده یا بخشی از متن..."
            android:textColorHint="@color/muted"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/search"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:text="⌕"
            android:textColor="@color/white"
            android:textSize="21sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مثال: وجودم اشک و لاشه چاوشی"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg" />

    <TextView
        android:id="@+id/nowPlaying"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="♪  هنوز چیزی پخش نمی‌شود"
        android:textColor="@color/white"
        android:background="@drawable/bg_card"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        android:weightSum="4">

        <TextView
            android:text="⌕\nجستجو"
            android:textColor="@color/purple"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="11sp" />

        <TextView
            android:text="▣\nکتابخانه"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="11sp" />

        <TextView
            android:text="♫\nدر حال پخش"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="11sp" />

        <TextView
            android:text="⚙\nتنظیمات"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
